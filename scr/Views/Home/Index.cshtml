@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container">

    <!-- Hero -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
        <div class="container-fluid py-5 text-center">

            <h1 class="display-4 fw-bold">
                🍳 Recipe Website
            </h1>

            <p class="fs-4 mt-3">
                Khám phá và chia sẻ những công thức nấu ăn yêu thích
            </p>

            <p class="text-muted">
                Tìm kiếm món ăn, xem nguyên liệu và cách chế biến
                một cách dễ dàng.
            </p>

            <a href="/Recipe"
               class="btn btn-primary btn-lg mt-3">
                🍽️ Khám phá công thức
            </a>

        </div>
    </div>


    <!-- Features -->
    <div class="row text-center mt-5">

        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="fs-1">
                        🔎
                    </div>

                    <h4 class="card-title mt-3">
                        Tìm kiếm công thức
                    </h4>

                    <p class="card-text text-muted">
                        Tìm món ăn nhanh chóng theo tên
                        và danh mục.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="fs-1">
                        🥗
                    </div>

                    <h4 class="card-title mt-3">
                        Nhiều món ăn
                    </h4>

                    <p class="card-text text-muted">
                        Khám phá các công thức món Việt,
                        món Nhật và món Âu.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="fs-1">
                        💬
                    </div>

                    <h4 class="card-title mt-3">
                        Chia sẻ & bình luận
                    </h4>

                    <p class="card-text text-muted">
                        Đăng công thức và chia sẻ
                        trải nghiệm với cộng đồng.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Call to action -->

    <div class="text-center mt-5 mb-5">

        <h3>
            Bạn có công thức yêu thích?
        </h3>

        <p class="text-muted">
            Đăng nhập để bắt đầu chia sẻ công thức của bạn.
        </p>

        <a href="/Account/Register"
           class="btn btn-success">
            📝 Đăng ký ngay
        </a>

    </div>

</div>