@model RecipeWebsite.Models.Recipe

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">

    <div class="row">

        <!-- Hình ảnh -->
        <div class="col-md-6">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Title">
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                    <span class="text-muted">
                        Chưa có hình ảnh
                    </span>
                </div>
            }

        </div>

        <!-- Thông tin món ăn -->
        <div class="col-md-6">

            <h1 class="fw-bold">
                @Model.Title
            </h1>

            <p class="text-muted">
                @Model.Description
            </p>

            <hr />

            <div class="mb-3">

                <p>
                    <strong>📂 Danh mục:</strong>
                    @Model.Category?.Name
                </p>

                <p>
                    <strong>⏱ Thời gian nấu:</strong>
                    @Model.CookingTime phút
                </p>

                <p>
                    <strong>👥 Khẩu phần:</strong>
                    @Model.Servings người
                </p>

            </div>

        </div>

    </div>


    <!-- Nguyên liệu -->

    <div class="mt-5">

        <h2 class="fw-bold">
            🥕 Nguyên liệu
        </h2>

        <div class="card shadow-sm">

            <div class="card-body">

                <ul class="list-group list-group-flush">

                    @foreach (var item in Model.RecipeIngredients)
                    {
                        <li class="list-group-item">

                            <strong>
                                @item.Ingredient?.Name
                            </strong>

                            <span class="text-muted">
                                — @item.Quantity @item.Unit
                            </span>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </div>


    <!-- Hướng dẫn -->

    <div class="mt-5">

        <h2 class="fw-bold">
            👨‍🍳 Hướng dẫn nấu
        </h2>

        <div class="card shadow-sm">

            <div class="card-body">

                <p style="white-space: pre-line;">
                    @Model.Instructions
                </p>

            </div>

        </div>

    </div>


    <!-- Quay lại -->

    <div class="mt-5">

        <h2 class="fw-bold">💬 Bình luận</h2>

        <div class="card shadow-sm">
            <div class="card-body">

                @if (Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="border-bottom pb-3 mb-3">

                            <p class="mb-1 fw-bold">
                                @comment.User?.FullName
                            </p>

                            <p class="mb-1">
                                @comment.Content
                            </p>

                            <small class="text-muted">
                                @comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </small>

                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">
                        Chưa có bình luận nào.
                    </p>
                }

            </div>
        </div>

    </div>

    <div class="mt-4">

        <h5 class="fw-bold">✍️ Viết bình luận</h5>

        <form asp-action="AddComment" method="post">

            <input type="hidden" name="recipeId" value="@Model.Id" />

            <div class="mb-3">
                <textarea name="content" class="form-control" rows="4"
                          placeholder="Nhập bình luận của bạn..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                💬 Gửi bình luận
            </button>
        </form>

    </div>

    <div class="mt-4 mb-5">
        @{
            var currentUserId = Context.Session.GetInt32("UserId");
            var currentRole = Context.Session.GetString("Role");

            bool canManageRecipe =
                currentUserId != null &&
                (currentRole == "Admin" || Model.UserId == currentUserId.Value);
        }

        @if (canManageRecipe)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                ✏️ Sửa
            </a>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">

                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Bạn có chắc muốn xóa công thức này không?');">
                    🗑️ Xóa
                </button>
            </form>
        }

        <a href="/Recipe" class="btn btn-secondary">
            ← Quay lại danh sách
        </a>
    </div>

</div>