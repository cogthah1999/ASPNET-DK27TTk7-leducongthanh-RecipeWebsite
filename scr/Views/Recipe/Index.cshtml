@model List<RecipeWebsite.Models.Recipe>

@{
    ViewData["Title"] = "Công thức nấu ăn";
}

<div class="container mt-4">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">🍳 Công thức nấu ăn</h1>
        <p class="text-muted">
            Khám phá những món ăn ngon và dễ thực hiện
        </p>
    </div>

    <form method="get" action="/Recipe/Index" class="mb-4">

        <div class="row g-2">

            <div class="col-md-6">
                <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control"
                       placeholder="🔍 Tìm kiếm công thức..." />
            </div>

            <div class="col-md-4">
                <select name="categoryId" class="form-select">

                    <option value="">-- Tất cả danh mục --</option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id"
                                selected="@(Context.Request.Query["categoryId"] == category.Id.ToString())">
                            @category.Name
                        </option>
                    }

                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    Tìm kiếm
                </button>
            </div>

        </div>

    </form>

    <div class="row g-4">

        @foreach (var recipe in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                    {
                        <img src="@recipe.ImageUrl" class="card-img-top" alt="@recipe.Title"
                             style="height: 220px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                            <span class="text-muted">
                                Chưa có hình ảnh
                            </span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @recipe.Title
                        </h5>

                        <p class="card-text text-muted">
                            @recipe.Description
                        </p>

                        <div class="mb-3">
                            <span class="me-3">
                                ⏱ @recipe.CookingTime phút
                            </span>

                            <span>
                                👥 @recipe.Servings người
                            </span>
                        </div>

                        <a href="/Recipe/Details/@recipe.Id" class="btn btn-primary mt-auto">
                            Xem chi tiết
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (Context.Session.GetInt32("UserId") != null)
    {
        <div class="d-flex justify-content-end mt-4 mb-5">
            <a href="/Recipe/Create" class="btn btn-success">
                ➕ Tạo công thức mới
            </a>
        </div>
    }

</div>