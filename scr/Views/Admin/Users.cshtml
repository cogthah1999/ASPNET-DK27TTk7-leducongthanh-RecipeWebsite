@model List<RecipeWebsite.Models.User>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">👥 Quản lý người dùng</h2>

        <a href="/Admin" class="btn btn-secondary">
            ← Dashboard
        </a>
    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>

                        <td>@user.FullName</td>

                        <td>@user.Email</td>

                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-danger">
                                    Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary">
                                    User
                                </span>
                            }
                        </td>

                        <td>
                            @user.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @if (user.Id == Context.Session.GetInt32("UserId"))
                            {
                                <span class="text-muted">
                                    Đang đăng nhập
                                </span>
                            }
                            else
                            {
                                <form asp-action="DeleteUser" method="post" class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này không?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Xóa
                                    </button>

                                </form>
                            }
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>