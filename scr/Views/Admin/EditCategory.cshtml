@model RecipeWebsite.Models.Category

@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">
        ✏️ Sửa danh mục
    </h2>

    <form method="post">

        <input type="hidden"
               asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name"
                   class="form-label">
                Tên danh mục
            </label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Description"
                   class="form-label">
                Mô tả
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            💾 Lưu thay đổi
        </button>

        <a href="/Admin/Categories"
           class="btn btn-secondary">
            Hủy
        </a>

    </form>

</div>